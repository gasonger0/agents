{
  "provider": {
    "<provider_name>": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "<provider_name>",
      "options": {
        "baseURL": "<provider_url>",
        "apiKey": "<your_API_key>"
      },
      "models": {
        "deepseek-v4-flash-0731": {
          "name": "deepseek-v4-flash-0731",
          "reasoning": true,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 204800,
            "output": 64000
          },
          "variants": {
            "fast": {
              "options": {
                "reasoningEffort": "low",
                "reasoningSummary": "concise"
              }
            },
            "deep": {
              "options": {
                "reasoningEffort": "high",
                "reasoningSummary": "detailed"
              }
            }
          }
        },
        "glm-5.3-flash": {
          "name": "glm-5.3-flash",
          "reasoning": true,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 262144,
            "output": 64000
          },
          "variants": {
            "fast": {
              "options": {
                "reasoningEffort": "low",
                "reasoningSummary": "concise"
              }
            },
            "deep": {
              "options": {
                "reasoningEffort": "high",
                "reasoningSummary": "detailed"
              }
            }
          }
        },
        "qwen3.6-35b-a3b": {
          "name": "qwen3.6-35b-a3b",
          "reasoning": true,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 131072,
            "output": 64000
          },
          "options": {
            "reasoningSummary": "concise"
          }
        },
        "gemma-4-26b-a4b": {
          "name": "gemma-4-26b-a4b",
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 131072,
            "output": 32000
          },
          "variants": {
            "fast": {
              "options": {
                "reasoningEffort": "low",
                "reasoningSummary": "concise"
              }
            },
            "deep": {
              "options": {
                "reasoningEffort": "high",
                "reasoningSummary": "detailed"
              }
            }
          }
        },
        "qwen3.8-27b": {
          "name": "qwen3.8-27b",
          "reasoning": true,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 262144,
            "output": 32000
          },
          "variants": {
            "fast": {
              "options": {
                "reasoningEffort": "low",
                "reasoningSummary": "concise"
              }
            },
            "deep": {
              "options": {
                "reasoningEffort": "high",
                "reasoningSummary": "detailed"
              }
            }
          }
        }
      }
    }
  },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@foae/opencode-timings@latest",
    "opencode-dynamic-workflow-plugin"
  ],
  "subagent_depth": 2,
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "architect",
  "model": "<provider_name>/qwen3.8-27b",
  "small_model": "<provider_name>/gemma-4-26b-a4b",
  "lsp": true,
  "permission": {
    "*": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "npm run *": "allow",
      "npx vitest*": "allow",
      "php *": "allow",
      "composer *": "allow",
      "phpunit*": "allow",
      "go build*": "allow",
      "go test*": "allow",
      "eslint *": "allow",
      "prettier *": "allow",
      "docker ps*": "allow",
      "docker logs*": "allow",
      "docker compose config*": "allow"
    },
    "edit": "deny"
  },
  "mcp": {
    "ssh": {
      "type": "local",
      "command": ["npx", "-y", "opencode-plugin-ssh"]
    }
  },
  "agents": {
    "architect": {
      "mode": "primary",
      "model": "<provider_name>/qwen3.8-27b",
      "temperature": 0.1,
      "permission": {
        "edit": {
          "*": "deny",
          "docs/specs/*": "allow",
          "docs/plans/*": "allow"
        },
        "bash": {
          "*": "ask",
          "git *": "allow",
          "ls *": "allow",
          "cat *": "allow"
        },
        "subagent": {
          "*": "deny",
          "explore": "allow",
          "qa": "allow",
          "backend": "allow",
          "frontend": "allow",
          "reviewer": "allow",
          "documenter": "allow",
          "devops": "allow"
        },
        "mcp": {
          "*": "deny",
          "ssh_exec": "ask",
          "ssh_read_file": "allow"
        }
      }
    },
    "qa": {
      "mode": "subagent",
      "model": "<provider_name>/glm-5.3-flash",
      "temperature": 0.1,
      "permission": {
        "edit": {
          "*": "deny",
          "docs/tests/*": "allow",
          "tests/*": "allow",
          "**/*.test.*": "allow",
          "**/*.spec.*": "allow"
        },
        "bash": {
          "*": "ask",
          "vitest*": "allow",
          "phpunit*": "allow",
          "npm run test*": "allow",
          "composer test*": "allow"
        },
        "mcp": { "*": "deny", "ssh_read_file": "allow" }
      }
    },
    "backend": {
      "mode": "subagent",
      "model": "<provider_name>/qwen3.6-35b-a3b",
      "temperature": 0.2,
      "permission": {
        "edit": {
          "*": "deny",
          "src/**": "allow",
          "app/**": "allow",
          "tests/**": "allow",
          "!src/frontend/**": "deny"
        },
        "bash": {
          "*": "ask",
          "php *": "allow",
          "composer *": "allow",
          "phpunit*": "allow",
          "go build*": "allow",
          "go test*": "allow",
          "docker exec *": "ask"
        },
        "mcp": {
          "*": "deny",
          "ssh_read_file": "allow",
          "ssh_write_file": "allow",
          "ssh_exec": "ask"
        }
      }
    },
    "frontend": {
      "mode": "subagent",
      "model": "<provider_name>/glm-5.3-flash",
      "temperature": 0.2,
      "permission": {
        "edit": {
          "*": "deny",
          "src/frontend/**": "allow",
          "resources/js/**": "allow",
          "src/components/**": "allow",
          "tests/js/**": "allow",
          "**/*.vue": "allow",
          "**/*.tsx": "allow",
          "**/*.ts": "allow",
          "!src/backend/**": "deny"
        },
        "bash": {
          "*": "ask",
          "npm run *": "allow",
          "npx vitest*": "allow",
          "eslint *": "allow",
          "prettier *": "allow"
        },
        "mcp": {
          "*": "deny",
          "ssh_read_file": "allow",
          "ssh_write_file": "allow",
          "ssh_exec": "ask"
        }
      }
    },
    "explore": {
      "mode": "subagent",
      "model": "<provider_name>/gemma-4-26b-a4b",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "grep *": "allow",
          "find *": "allow",
          "ls *": "allow",
          "cat *": "allow"
        },
        "mcp": { "*": "deny", "ssh_read_file": "allow", "ssh_exec": "ask" }
      }
    },
    "reviewer": {
      "mode": "subagent",
      "model": "<provider_name>/qwen3.8-27b",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "git diff*": "allow",
          "git log*": "allow",
          "vitest*": "allow",
          "phpunit*": "allow"
        },
        "mcp": { "*": "deny", "ssh_read_file": "allow", "ssh_exec": "ask" }
      }
    },
    "documenter": {
      "mode": "subagent",
      "model": "<provider_name>/gemma-4-26b-a4b",
      "temperature": 0.2,
      "permission": {
        "edit": {
          "*": "deny",
          "docs/**": "allow",
          "*.md": "allow",
          "openapi/**": "allow",
          "swagger/**": "allow"
        },
        "bash": { "*": "ask", "ls *": "allow", "cat *": "allow" },
        "mcp": {
          "*": "deny",
          "ssh_read_file": "allow",
          "ssh_write_file": "allow"
        }
      }
    },
    "devops": {
      "mode": "subagent",
      "model": "<provider_name>/deepseek-v4-flash-0731",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "docker ps*": "allow",
          "docker logs*": "allow",
          "docker compose config*": "allow",
          "ls *": "allow",
          "cat *": "allow"
        },
        "mcp": { "*": "deny", "ssh_read_file": "allow", "ssh_exec": "ask" }
      }
    }
  }
}
